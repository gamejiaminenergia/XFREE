# Copy to jev-duum/.env (git-ignored) and fill in the values you need.
# An exported environment variable always wins over this file.
#
# Required for the jev / jev-assisted pilots. Never commit the real key.
TYPESAFE_API_KEY=
#
# Optional overrides ---------------------------------------------------------
#
# System One model id (default: jev-latest)
# TYPESAFE_MODEL=jev-latest
#
# System One endpoint (default: the public API)
# TYPESAFE_URL=https://api.typesafe.ai
#
# Frozen request shape: v1 | v2 | v3 | v3w (default: v3w)
# JEV_PROMPT_VERSION=v3w
#
# Passive audit log (docker compose up -d at the repository root)
# JEV_LOG_URL=http://localhost:3000
# JEV_NO_LOG=1          # disable logging entirely
# JEV_LOG_DEBUG=1       # print dropped audit documents to stderr
#
# Opt in to the live API smoke test (JEV_LIVE=1 plus a key)
# JEV_LIVE=1
