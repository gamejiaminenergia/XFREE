# The pinned Duum engine keeps its own git repository and remote; this root
# project versions the Jev pilot (docs/ and jev-duum/).
duum/

# Virtualenvs, caches and build output
.venv/
**/.venv/
__pycache__/
**/__pycache__/
*.py[cod]
*.egg-info/
**/*.egg-info/
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
dist/
build/

# Local secrets and regenerable evidence
.env
**/.env
artifacts/
**/artifacts/

# Grabaciones de vídeo: binarios grandes, nunca versionadas. El índice
# (video/README.md) y los .gitkeep sí se versionan; el medio, jamás.
video/**/*.mp4
video/**/*.mkv
video/**/*.mov
video/**/*.webm
video/**/*.gif
# La ficha .json describe un vídeo que no se versiona, así que tampoco ella:
# si el clip vive solo en local, una ficha en git apunta a un fichero ausente.
# El índice de clips es video/README.md.
video/**/*.json
video/.ffmpeg-*.log
